
(DEFPROP CODE-STATEMENT (QUALIFIED-EXPRESSION ;) GRAMMER)

(DEFPROP ADDRESS-SPECIFICATION
 ((^ FOR) NAME (^ USE) (^ AT) SIMPLE-EXPRESSION ;)
 GRAMMER)

(DEFPROP ALIGNMENT-CLAUSE ((^ AT) (^ MOD) SIMPLE-EXPRESSION) GRAMMER)

(DEFPROP LOCATION ((^ AT) SIMPLE-EXPRESSION (^ RANGE) RANGE) GRAMMER)

(DEFPROP RECORD-TYPE-REPRESENTATION
 ((^ FOR)
  NAME 
  (^ USE)
  (^ RECORD)
  (/[ ALIGNMENT-CLAUSE ; /])
  (/{ NAME LOCATION ; })
  (^ END)
  (^ RECORD)
  ;)
 GRAMMER)

(DEFPROP ENUMERATION-TYPE-REPRESENTATION
 ((^ FOR) NAME (^ USE) AGGREGATE ;)
 GRAMMER)

(DEFPROP LENGTH-SPECIFICATION
 ((^ FOR) ATTRIBUTE (^ USE) EXPRESSION ;)
 GRAMMER)

(DEFPROP REPRESENTATION-SPECIFICATION
 (LENGTH-SPECIFICATION ! ENUMERATION-TYPE-REPRESENTATION !
		       RECORD-TYPE-REPRESENTATION ! ADDRESS-SPECIFICATION)
 GRAMMER)

(DEFPROP GENERIC-ACTUAL-PARAMETER
 (EXPRESSION ! NAME ! SUBTYPE-INDICATION)
 GRAMMER)

(DEFPROP GENERIC-ASSOCIATION
 ((/[ FORMAL-PARAMETER => /]) GENERIC-ACTUAL-PARAMETER)
 GRAMMER)

(DEFPROP GENERIC-INSTANTIATION
 ((^ NEW)
  NAME 
  (/[ /( GENERIC-ASSOCIATION (/{ /, GENERIC-ASSOCIATION }) /) /]))
 GRAMMER)

(DEFPROP GENERIC-PACKAGE-INSTANTIATION
 ((^ PACKAGE) IDENTIFIER (^ IS) GENERIC-INSTANTIATION ;)
 GRAMMER)

(DEFPROP GENERIC-SUBPROGRAM-INSTANTIATION
 (((^ PROCEDURE) IDENTIFIER (^ IS) GENERIC-INSTANTIATION ;)
  ! 
  ((^ FUNCTION) DESIGNATOR (^ IS) GENERIC-INSTANTIATION ;))
 GRAMMER)

(DEFPROP GENERIC-TYPE-DEFINITION
 ((/( <> /))
  ! 
  ((^ RANGE) <>)
  ! 
  ((^ DELTA) <>)
  ! 
  ((^ DIGITS) <>)
  ! 
  ARRAY-TYPE-DEFINITION 
  ! 
  ACCESS-TYPE-DEFINITION 
  ! 
  PRIVATE-TYPE-DEFINITION)
 GRAMMER)

(DEFPROP GENERIC-FORMAL-PARAMETER
 ((PARAMETER-DECLARATION ;)
  ! 
  ((^ TYPE)
   IDENTIFIER 
   (/[ DISCRIMINANT-PART /])
   (^ IS)
   GENERIC-TYPE-DEFINITION 
   ;)
  ! 
  ((^ WITH) SUBPROGRAM-SPECIFICATION (/[ (^ IS) NAME /]) ;)
  ! 
  ((^ WITH) SUBPROGRAM-SPECIFICATION (^ IS) <> ;))
 GRAMMER)

(DEFPROP GENERIC-PART
 ((^ GENERIC) (/{ GENERIC-FORMAL-PARAMETER }))
 GRAMMER)

(DEFPROP GENERIC-PACKAGE-DECLARATION
 (GENERIC-PART PACKAGE-SPECIFICATION ;)
 GRAMMER)

(DEFPROP GENERIC-SUBPROGRAM-DECLARATION
 (GENERIC-PART SUBPROGRAM-SPECIFICATION ;)
 GRAMMER)

(DEFPROP RAISE-STATEMENT ((^ RAISE) (/[ NAME /]) ;) GRAMMER)

(DEFPROP EXCEPTION-CHOICE (NAME ! (^ OTHERS)) GRAMMER)

(DEFPROP EXCEPTION-HANDLER
 ((^ WHEN)
  EXCEPTION-CHOICE 
  (/{ | EXCEPTION-CHOICE })
  => 
  SEQUENCE-OF-STATEMENTS)
 GRAMMER)

(DEFPROP EXCEPTION-DECLARATION
 (IDENTIFIER-LIST : (^ EXCEPTION) ;)
 GRAMMER)

(DEFPROP BODY-STUB
 ((SUBPROGRAM-SPECIFICATION (^ IS) (^ SEPARATE) ;)
  ! 
  (PACKAGE-BODY IDENTIFIER (^ IS) (^ SEPARATE) ;)
  ! 
  ((^ TASK) (^ BODY) IDENTIFIER (^ IS) (^ SEPARATE) ;))
 GRAMMER)

(DEFPROP SUBUNIT-BODY
 (SUBPROGRAM-BODY ! PACKAGE-BODY ! TASK-BODY)
 GRAMMER)

(DEFPROP SUBUNIT ((^ SEPARATE) /( NAME /) SUBUNIT-BODY) GRAMMER)

(DEFPROP WITH-CLAUSE ((^ WITH) NAME (/{ /, ^ UNIT-NAME }) ;) GRAMMER)

(DEFPROP CONTEXT-SPECIFICATION
 ((/{ WITH-CLAUSE (/[ USE-CLAUSE /]) }))
 GRAMMER)

(DEFPROP COMPILATION-UNIT
 ((CONTEXT-SPECIFICATION SUBPROGRAM-DECLARATION)
  ! 
  (CONTEXT-SPECIFICATION SUBPROGRAM-BODY)
  ! 
  (CONTEXT-SPECIFICATION PACKAGE-DECLARATION)
  ! 
  (CONTEXT-SPECIFICATION PACKAGE-BODY)
  ! 
  (CONTEXT-SPECIFICATION SUBUNIT))
 GRAMMER)

(DEFPROP COMPILATION ((/{ COMPILATION-UNIT })) GRAMMER)

(DEFPROP ABORT-STATEMENT ((^ ABORT) NAME (/{ /, ^ TASK-NAME })) GRAMMER)

(DEFPROP TIMED-ENTRY-CALL
 ((^ SELECT)
  ENTRY-CALL 
  (/[ SEQUENCE-OF-STATEMENTS /])
  (^ OR)
  DELAY-STATEMENT 
  (/[ SEQUENCE-OF-STATEMENTS /])
  (^ END)
  (^ SELECT)
  ;)
 GRAMMER)

(DEFPROP CONDITIONAL-ENTRY-CALL
 ((^ SELECT)
  ENTRY-CALL 
  (/[ SEQUENCE-OF-STATEMENTS /])
  (^ ELSE)
  SEQUENCE-OF-STATEMENTS 
  (^ END)
  (^ SELECT)
  ;)
 GRAMMER)

(DEFPROP SELECT-ALTERNATIVE
 ((ACCEPT-STATEMENT (/[ SEQUENCE-OF-STATEMENTS /]))
  ! 
  (DELAY-STATEMENT (/[ SEQUENCE-OF-STATEMENTS /]))
  ! 
  ((^ TERMINATE) ;))
 GRAMMER)

(DEFPROP SELECTIVE-WAIT
 ((^ SELECT)
  (/[ (^ WHEN) CONDITION => /])
  SELECT-ALTERNATIVE 
  (/{ (^ OR) (/[ (^ WHEN) CONDITION => /]) SELECT-ALTERNATIVE })
  (/[ (^ ELSE) SEQUENCE-OF-STATEMENTS /])
  (^ END)
  (^ SELECT)
  ;)
 GRAMMER)

(DEFPROP SELECT-STATEMENT
 (SELECTIVE-WAIT ! CONDITIONAL-ENTRY-CALL ! TIMED-ENTRY-CALL)
 GRAMMER)

(DEFPROP DELAY-STATEMENT ((^ DELAY) SIMPLE-EXPRESSION ;) GRAMMER)

(DEFPROP ACCEPT-STATEMENT
 ((^ ACCEPT)
  ENTRY-NAME 
  (/[ FORMAL-PART /])
  (/[ (^ DO) SEQUENCE-OF-STATEMENTS (^ END) (/[ IDENTIFIER /]) /])
  ;)
 GRAMMER)

(DEFPROP ENTRY-CALL (NAME (/[ /( ACTUAL-PARAMETER-PART /) /]) ;) GRAMMER)

(DEFPROP ENTRY-DECLARATION
 ((^ ENTRY) IDENTIFIER (/[ /( DISCRETE-RANGE /) /]) (/[ FORMAL-PART /]) ;)
 GRAMMER)

(DEFPROP TASK-BODY
 ((^ TASK)
  (^ BODY)
  IDENTIFIER 
  (^ IS)
  (/[ DECLARATIVE-PART /])
  (^ BEGIN)
  SEQUENCE-OF-STATEMENTS 
  (/[ (^ EXCEPTION) (/{ EXCEPTION-HANDLER }) /])
  (^ END)
  (/[ IDENTIFIER /])
  ;)
 GRAMMER)

(DEFPROP TASK-SPECIFICATION
 ((^ TASK)
  (/[ (^ TYPE) /])
  IDENTIFIER 
  (/[ (^ IS)
      (/{ ENTRY-DECLARATION })
      (/{ REPRESENTATION-SPECIFICATION })
      (^ END)
      (/[ IDENTIFIER /])
      /])
  ;)
 GRAMMER)

(DEFPROP TASK-DECLARATION (TASK-SPECIFICATION) GRAMMER)

(DEFPROP RENAMING-DECLARATION
 ((IDENTIFIER : TYPE-MARK (^ RENAMES) NAME ;)
  ! 
  (IDENTIFIER : (^ EXCEPTION) (^ RENAMES) NAME ;)
  ! 
  ((^ PACKAGE) IDENTIFIER (^ RENAMES) NAME ;)
  ! 
  ((^ TASK) IDENTIFIER (^ RENAMES) NAME ;)
  ! 
  (SUBPROGRAM-SPECIFICATION (^ RENAMES) NAME ;))
 GRAMMER)

(DEFPROP USE-CLAUSE ((^ USE) NAME (/{ /, NAME }) ;) GRAMMER)

(DEFPROP PRIVATE-TYPE-DEFINITION
 ((/[ (^ LIMITED) /]) (^ PRIVATE))
 GRAMMER)

(DEFPROP PACKAGE-BODY
 ((^ PACKAGE)
  (^ BODY)
  IDENTIFIER 
  (^ IS)
  DECLARATIVE-PART 
  (/[ (^ BEGIN)
      SEQUENCE-OF-STATEMENTS 
      (/[ (^ EXCEPTION) (/{ EXCEPTION-HANDLER }) /])
      /])
  (^ END)
  (/[ IDENTIFIER /])
  ;)
 GRAMMER)

(DEFPROP PACKAGE-SPECIFICATION
 ((^ PACKAGE)
  IDENTIFIER 
  (^ IS)
  (/{ DECLARATIVE-ITEM })
  (/[ (^ PRIVATE)
      (/{ DECLARATIVE-ITEM })
      (/{ REPRESENTATION-SPECIFICATION })
      /])
  (^ END)
  (/[ IDENTIFIER /]))
 GRAMMER)

(DEFPROP PACKAGE-DECLARATION
 ((PACKAGE-SPECIFICATION ;)
  ! 
  GENERIC-PACKAGE-DECLARATION 
  ! 
  GENERIC-PACKAGE-INSTANTIATION)
 GRAMMER)

(DEFPROP ACTUAL-PARAMETER (EXPRESSION) GRAMMER)

(DEFPROP FORMAL-PARAMETER (IDENTIFIER) GRAMMER)

(DEFPROP PARAMETER-ASSOCIATION
 ((/[ FORMAL-PARAMETER => /]) ACTUAL-PARAMETER)
 GRAMMER)

(DEFPROP ACTUAL-PARAMETER-PART
 (PARAMETER-ASSOCIATION (/{ /, PARAMETER-ASSOCIATION }))
 GRAMMER)

(DEFPROP FUNCTION-CALL
 ((NAME /( ACTUAL-PARAMETER-PART /)) ! (NAME /( /)))
 GRAMMER)

(DEFPROP PROCEDURE-CALL
 (NAME (/[ /( ACTUAL-PARAMETER-PART /) /]) ;)
 GRAMMER)

(DEFPROP SUBPROGRAM-BODY
 (SUBPROGRAM-SPECIFICATION
  (^ IS)
  DECLARATIVE-PART 
  (^ BEGIN)
  SEQUENCE-OF-STATEMENTS 
  (/[ (^ EXCEPTION) (/{ EXCEPTION-HANDLER }) /])
  (^ END)
  (/[ DESIGNATOR /])
  ;)
 GRAMMER)

(DEFPROP MODE ((/[ (^ IN) /]) ! (^ OUT) ! ((^ IN) (^ OUT))) GRAMMER)

(DEFPROP PARAMETER-DECLARATION
 (IDENTIFIER-LIST : MODE SUBTYPE-INDICATION (/[ := EXPRESSION /]))
 GRAMMER)

(DEFPROP FORMAL-PART
 (/( PARAMETER-DECLARATION (/{ ;PARAMETER-DECLARATION }) /))
 GRAMMER)

(DEFPROP OPERATOR-SYMBOL (CHARACTER-STRING) GRAMMER)

(DEFPROP DESIGNATOR (IDENTIFIER ! OPERATOR-SYMBOL) GRAMMER)

(DEFPROP SUBPROGRAM-SPECIFICATION
 (((^ PROCEDURE) IDENTIFIER (/[ FORMAL-PART /]))
  ! 
  ((^ FUNCTION)
   DESIGNATOR 
   (/[ FORMAL-PART /])
   (^ RETURN)
   SUBTYPE-INDICATION))
 GRAMMER)

(DEFPROP SUBPROGRAM-DECLARATION
 ((SUBPROGRAM-SPECIFICATION ;)
  ! 
  GENERIC-SUBPROGRAM-DECLARATION 
  ! 
  GENERIC-SUBPROGRAM-INSTANTIATION)
 GRAMMER)

(DEFPROP GOTO-STATEMENT ((^ GOTO) NAME ;) GRAMMER)

(DEFPROP RETURN-STATEMENT ((^ RETURN) (/[ EXPRESSION /]) ;) GRAMMER)

(DEFPROP EXIT-STATEMENT
 ((^ EXIT) (/[ NAME /]) (/[ (^ WHEN) CONDITION /]) ;)
 GRAMMER)

(DEFPROP BLOCK
 ((/[ IDENTIFIER ":" /])
  (/[ (^ DECLARE) DECLARATIVE-PART /])
  (^ BEGIN)
  SEQUENCE-OF-STATEMENTS 
  (/[ (^ EXCEPTION) (/{ EXCEPTION-HANDLER }) /])
  (^ END)
  (/[ IDENTIFIER /])
  ;)
 GRAMMER)

(DEFPROP LOOP-PARAMETER (IDENTIFIER) GRAMMER)

(DEFPROP ITERATION-CLAUSE
 ((^ FOR)
  LOOP-PARAMETER 
  (^ IN)
  (/[ (^ REVERSE) /])
  DISCRETE-RANGE 
  ! 
  ((^ WHILE) CONDITION))
 GRAMMER)

(DEFPROP BASIC-LOOP
 ((^ LOOP) SEQUENCE-OF-STATEMENTS (^ END) (^ LOOP))
 GRAMMER)

(DEFPROP LOOP-STATEMENT
 ((/[ IDENTIFIER ":" /])
  (/[ ITERATION-CLAUSE /])
  BASIC-LOOP 
  (/[ IDENTIFIER /])
  ;)
 GRAMMER)

(DEFPROP CASE-STATEMENT
 ((^ CASE)
  EXPRESSION 
  (^ IS)
  (/{ (^ WHEN) CHOICE (/{ | CHOICE }) => SEQUENCE-OF-STATEMENTS })
  (^ END)
  (^ CASE)
  ;)
 GRAMMER)

(DEFPROP CONDITION (EXPRESSION) GRAMMER)

(DEFPROP IF-STATEMENT
 ((^ IF)
  CONDITION 
  (^ THEN)
  SEQUENCE-OF-STATEMENTS 
  (/{ (^ ELSIF) CONDITION (^ THEN) SEQUENCE-OF-STATEMENTS })
  (/[ (^ ELSE) SEQUENCE-OF-STATEMENTS /])
  (^ END)
  (^ IF)
  ;)
 GRAMMER)

(DEFPROP ASSIGNMENT-STATEMENT (NAME := EXPRESSION ;) GRAMMER)

(DEFPROP NULL-STATEMENT ((^ NULL) ;) GRAMMER)

(DEFPROP LABEL (<< IDENTIFIER >>) GRAMMER)

(DEFPROP COMPOUND-STATEMENT
 (IF-STATEMENT ! CASE-STATEMENT ! LOOP-STATEMENT ! BLOCK ! ACCEPT-STATEMENT
	       ! SELECT-STATEMENT)
 GRAMMER)

(DEFPROP SIMPLE-STATEMENT
 (NULL-STATEMENT ! ASSIGNMENT-STATEMENT ! EXIT-STATEMENT ! RETURN-STATEMENT
		 ! GOTO-STATEMENT ! PROCEDURE-CALL ! ENTRY-CALL !
		 DELAY-STATEMENT ! ABORT-STATEMENT ! RAISE-STATEMENT !
		 CODE-STATEMENT)
 GRAMMER)

(DEFPROP STATEMENT
 (((/{ LABEL }) SIMPLE-STATEMENT) ! ((/{ LABEL }) COMPOUND-STATEMENT))
 GRAMMER)

(DEFPROP SEQUENCE-OF-STATEMENTS (STATEMENT (/{ STATEMENT })) GRAMMER)

(DEFPROP ALLOCATOR
 (((^ NEW) TYPE-MARK (/[ /( EXPRESSION /) /]))
  ! 
  ((^ NEW) TYPE-MARK AGGREGATE)
  ! 
  ((^ NEW) TYPE-MARK DISCRIMINANT-CONSTRAINT)
  ! 
  ((^ NEW) TYPE-MARK INDEX-CONSTRAINT))
 GRAMMER)

(DEFPROP QUALIFIED-EXPRESSION
 ((TYPE-MARK /' /( EXPRESSION /)) ! (TYPE-MARK /' AGGREGATE))
 GRAMMER)

(DEFPROP TYPE-CONVERSION (TYPE-MARK /( EXPRESSION /)) GRAMMER)

(DEFPROP EXPONENTIATING-OPERATOR (**) GRAMMER)

(DEFPROP MULTIPLYING-OPERATOR (* ! / ! (^ MOD) ! (^ REM)) GRAMMER)

(DEFPROP UNARY-OPERATOR (+ ! /- ! (^ NOT)) GRAMMER)

(DEFPROP ADDING-OPERATOR (+ ! /- ! &) GRAMMER)

(DEFPROP RELATIONAL-OPERATOR (= ! //= ! < ! <= ! > ! >=) GRAMMER)

(DEFPROP LOGICAL-OPERATOR ((^ AND) ! (^ OR) ! (^ XOR)) GRAMMER)

(DEFPROP PRIMARY
 (LITERAL ! 
	  AGGREGATE 
	  ! 
	  NAME 
	  ! 
	  ALLOCATOR 
	  ! 
	  FUNCTION-CALL 
	  ! 
	  TYPE-CONVERSION 
	  ! 
	  QUALIFIED-EXPRESSION 
	  ! 
	  (/( EXPRESSION /)))
 GRAMMER)

(DEFPROP FACTOR (PRIMARY (/[ ** PRIMARY /])) GRAMMER)

(DEFPROP TERM (FACTOR (/{ MULTIPLYING-OPERATOR FACTOR })) GRAMMER)

(DEFPROP SIMPLE-EXPRESSION
 ((/[ UNARY-OPERATOR /]) TERM (/{ ADDING-OPERATOR TERM }))
 GRAMMER)

(DEFPROP RELATION
 ((SIMPLE-EXPRESSION (/[ RELATIONAL-OPERATOR SIMPLE-EXPRESSION /]))
  ! 
  (SIMPLE-EXPRESSION (/[ (^ NOT) /]) (^ IN) RANGE)
  ! 
  (SIMPLE-EXPRESSION (/[ (^ NOT) /]) (^ IN) SUBTYPE-INDICATION))
 GRAMMER)

(DEFPROP EXPRESSION
 ((RELATION (/{ (^ AND) RELATION }))
  ! 
  (RELATION (/{ (^ OR) RELATION }))
  ! 
  (RELATION (/{ (^ XOR) RELATION }))
  ! 
  (RELATION (/{ (^ AND) (^ THEN) RELATION }))
  ! 
  (RELATION (/{ (^ OR) (^ ELSE) RELATION })))
 GRAMMER)

(DEFPROP COMPONENT-ASSOCIATION
 ((/[ CHOICE (/{ | CHOICE }) => /]) EXPRESSION)
 GRAMMER)

(DEFPROP AGGREGATE
 (/( COMPONENT-ASSOCIATION (/{ /, COMPONENT-ASSOCIATION }) /))
 GRAMMER)

(DEFPROP LITERAL
 (NUMERIC-LITERAL ! ENUMERATION-LITERAL ! CHARACTER-STRING ! (^ NULL))
 GRAMMER)

(DEFPROP ATTRIBUTE (NAME /' IDENTIFIER) GRAMMER)

(DEFPROP SELECTED-COMPONENT
 ((NAME /. IDENTIFIER) ! (NAME /. (^ ALL)) ! (NAME /. OPERATOR-SYMBOL))
 GRAMMER)

(DEFPROP SLICE (NAME /( DISCRETE-RANGE /)) GRAMMER)

(DEFPROP INDEXED-COMPONENT
 (NAME /( EXPRESSION (/{ /, EXPRESSION }) /))
 GRAMMER)

(DEFPROP NAME
 (IDENTIFIER ! INDEXED-COMPONENT ! SLICE ! SELECTED-COMPONENT ! ATTRIBUTE !
	     FUNCTION-CALL ! OPERATOR-SYMBOL)
 GRAMMER)

(DEFPROP BODY (SUBPROGRAM-BODY ! PACKAGE-BODY ! TASK-BODY) GRAMMER)

(DEFPROP PROGRAM-COMPONENT
 (BODY ! PACKAGE-DECLARATION ! TASK-DECLARATION ! BODY-STUB)
 GRAMMER)

(DEFPROP DECLARATIVE-ITEM (DECLARATION ! USE-CLAUSE) GRAMMER)

(DEFPROP DECLARATIVE-PART
 ((/{ DECLARATIVE-ITEM })
  (/{ REPRESENTATION-SPECIFICATION })
  (/{ PROGRAM-COMPONENT }))
 GRAMMER)

(DEFPROP INCOMPLETE-TYPE-DECLARATION
 ((^ TYPE) IDENTIFIER (/[ DISCRIMINANT-PART /]) ;)
 GRAMMER)

(DEFPROP ACCESS-TYPE-DEFINITION ((^ ACCESS) SUBTYPE-INDICATION) GRAMMER)

(DEFPROP CHOICE
 (SIMPLE-EXPRESSION ! DISCRETE-RANGE ! (^ OTHERS))
 GRAMMER)

(DEFPROP VARIANT-PART
 ((^ CASE)
  DISCRIMINANT-NAME 
  (^ IS)
  (/{ (^ WHEN) CHOICE (/{ | CHOICE }) => COMPONENT-LIST })
  (^ END)
  (^ CASE)
  ;)
 GRAMMER)

(DEFPROP DISCRIMINANT-SPECIFICATION
 ((/[ NAME (/{ | NAME }) => /]) EXPRESSION)
 GRAMMER)

(DEFPROP DISCRIMINANT-CONSTRAINT
 (/( DISCRIMINANT-SPECIFICATION 
     (/{ /, DISCRIMINANT-SPECIFICATION })
     /))
 GRAMMER)

(DEFPROP DISCRIMINANT-DECLARATION
 (IDENTIFIER-LIST : SUBTYPE-INDICATION (/[ := EXPRESSION /]))
 GRAMMER)

(DEFPROP DISCRIMINANT-PART
 (/( DISCRIMINANT-DECLARATION (/{ /, DISCRIMINANT-DECLARATION }) /))
 GRAMMER)

(DEFPROP COMPONENT-DECLARATION
 ((IDENTIFIER-LIST : SUBTYPE-INDICATION (/[ := EXPRESSION /]) ;)
  ! 
  (IDENTIFIER-LIST : ARRAY-TYPE-DEFINITION (/[ := EXPRESSION /]) ;))
 GRAMMER)

(DEFPROP COMPONENT-LIST
 (((/{ COMPONENT-DECLARATION }) (/[ VARIANT-PART /]))
  ! 
  (^ NULL)
  ;)
 GRAMMER)

(DEFPROP RECORD-TYPE-DEFINITION
 ((^ RECORD) COMPONENT-LIST (^ END) (^ RECORD))
 GRAMMER)

(DEFPROP DISCRETE-RANGE
 ((TYPE-MARK (/[ RANGE-CONSTRAINT /])) ! RANGE)
 GRAMMER)

(DEFPROP INDEX-CONSTRAINT
 (/( DISCRETE-RANGE (/{ /, DISCRETE-RANGE }) /))
 GRAMMER)

(DEFPROP INDEX (TYPE-MARK (^ RANGE) <>) GRAMMER)

(DEFPROP ARRAY-TYPE-DEFINITION
 (((^ ARRAY) /( INDEX (/{ /, INDEX }) /) (^ OF) SUBTYPE-INDICATION)
  ! 
  ((^ ARRAY) INDEX-CONSTRAINT (^ OF) SUBTYPE-INDICATION))
 GRAMMER)

(DEFPROP FIXED-POINT-CONSTRAINT
 ((^ DELTA) SIMPLE-EXPRESSION (/[ RANGE-CONSTRAINT /]))
 GRAMMER)

(DEFPROP FLOATING-POINT-CONSTRAINT
 ((^ DIGITS) STATIC-SIMPLE-EXPRESSION (/[ RANGE-CONSTRAINT /]))
 GRAMMER)

(DEFPROP ACCURACY-CONSTRAINT
 (FLOATING-POINT-CONSTRAINT ! FIXED-POINT-CONSTRAINT)
 GRAMMER)

(DEFPROP REAL-TYPE-DEFINITION (ACCURACY-CONSTRAINT) GRAMMER)

(DEFPROP INTEGER-TYPE-DEFINITION (RANGE-CONSTRAINT) GRAMMER)

(DEFPROP CHARACTER-LITERAL (/' CHARACTER /') GRAMMER)

(DEFPROP ENUMERATION-LITERAL (IDENTIFIER ! CHARACTER-LITERAL) GRAMMER)

(DEFPROP ENUMERATION-TYPE-DEFINITION
 (/( ENUMERATION-LITERAL (/{ /, ENUMERATION-LITERAL }) /))
 GRAMMER)

(DEFPROP RANGE (SIMPLE-EXPRESSION /. SIMPLE-EXPRESSION) GRAMMER)

(DEFPROP RANGE-CONSTRAINT ((^ RANGE) RANGE) GRAMMER)

(DEFPROP DERIVED-TYPE-DEFINITION ((^ NEW) SUBTYPE-INDICATION) GRAMMER)

(DEFPROP CONSTRAINT
 (RANGE-CONSTRAINT ! ACCURACY-CONSTRAINT ! INDEX-CONSTRAINT !
		   DISCRIMINANT-CONSTRAINT)
 GRAMMER)

(DEFPROP TYPE-MARK (NAME) GRAMMER)

(DEFPROP SUBTYPE-INDICATION (TYPE-MARK (/[ CONSTRAINT /])) GRAMMER)

(DEFPROP SUBTYPE-DECLARATION
 ((^ SUBTYPE) IDENTIFIER (^ IS) SUBTYPE-INDICATION ;)
 GRAMMER)

(DEFPROP TYPE-DECLARATION
 (((^ TYPE) IDENTIFIER (/[ DISCRIMINANT-PART /]) (^ IS) TYPE-DEFINITION ;)
  ! 
  INCOMPLETE-TYPE-DECLARATION)
 GRAMMER)

(DEFPROP TYPE-DEFINITION
 (ENUMERATION-TYPE-DEFINITION ! INTEGER-TYPE-DEFINITION !
			      REAL-TYPE-DEFINITION ! ARRAY-TYPE-DEFINITION
			      ! RECORD-TYPE-DEFINITION !
			      ACCESS-TYPE-DEFINITION !
			      DERIVED-TYPE-DEFINITION !
			      PRIVATE-TYPE-DEFINITION)
 GRAMMER)

(DEFPROP IDENTIFIER-LIST (IDENTIFIER (/{ /, IDENTIFIER })) GRAMMER)

(DEFPROP NUMBER-DECLARATION
 (IDENTIFIER-LIST : (^ CONSTANT) := EXPRESSION ;)
 GRAMMER)

(DEFPROP OBJECT-DECLARATION
 ((IDENTIFIER-LIST
   : 
   (/[ (^ CONSTANT) /])
   SUBTYPE-INDICATION 
   (/[ := EXPRESSION /])
   ;)
  ! 
  (IDENTIFIER-LIST
   : 
   (/[ (^ CONSTANT) /])
   ARRAY-TYPE-DEFINITION 
   (/[ := EXPRESSION /])
   ;))
 GRAMMER)

(DEFPROP DECLARATION
 (OBJECT-DECLARATION ! NUMBER-DECLARATION ! TYPE-DECLARATION !
		     SUBTYPE-DECLARATION ! SUBPROGRAM-DECLARATION !
		     PACKAGE-DECLARATION ! TASK-DECLARACTION !
		     EXCEPTION-DECLARATION ! RENAMING-DECLARATION)
 GRAMMER)

(DEFPROP ARGUMENT
 (((/[ IDENTIFIER => /]) NAME) ! ((/[ IDENTIFIER => /]) EXPRESSION))
 GRAMMER)

(DEFPROP PRAGMA
 ((^ PRAGMA) IDENTIFIER (/[ /( ARGUMENT (/{ /, ARGUMENT }) /) /]) ;)
 GRAMMER)

(NOCOMPILE
(DEFV RULES (CODE-STATEMENT ADDRESS-SPECIFICATION ALIGNMENT-CLAUSE 
	     LOCATION RECORD-TYPE-REPRESENTATION 
	     ENUMERATION-TYPE-REPRESENTATION LENGTH-SPECIFICATION 
	     REPRESENTATION-SPECIFICATION GENERIC-ACTUAL-PARAMETER 
	     GENERIC-ASSOCIATION GENERIC-INSTANTIATION 
	     GENERIC-PACKAGE-INSTANTIATION 
	     GENERIC-SUBPROGRAM-INSTANTIATION GENERIC-TYPE-DEFINITION 
	     GENERIC-FORMAL-PARAMETER GENERIC-PART 
	     GENERIC-PACKAGE-DECLARATION GENERIC-SUBPROGRAM-DECLARATION 
	     RAISE-STATEMENT EXCEPTION-CHOICE EXCEPTION-HANDLER 
	     EXCEPTION-DECLARATION BODY-STUB SUBUNIT-BODY SUBUNIT 
	     WITH-CLAUSE CONTEXT-SPECIFICATION COMPILATION-UNIT 
	     COMPILATION ABORT-STATEMENT TIMED-ENTRY-CALL 
	     CONDITIONAL-ENTRY-CALL SELECT-ALTERNATIVE SELECTIVE-WAIT 
	     SELECT-STATEMENT DELAY-STATEMENT ACCEPT-STATEMENT 
	     ENTRY-CALL ENTRY-DECLARATION TASK-BODY TASK-SPECIFICATION 
	     TASK-DECLARATION RENAMING-DECLARATION USE-CLAUSE 
	     PRIVATE-TYPE-DEFINITION PACKAGE-BODY PACKAGE-SPECIFICATION 
	     PACKAGE-DECLARATION ACTUAL-PARAMETER FORMAL-PARAMETER 
	     PARAMETER-ASSOCIATION ACTUAL-PARAMETER-PART FUNCTION-CALL 
	     PROCEDURE-CALL SUBPROGRAM-BODY MODE PARAMETER-DECLARATION 
	     FORMAL-PART OPERATOR-SYMBOL DESIGNATOR 
	     SUBPROGRAM-SPECIFICATION SUBPROGRAM-DECLARATION 
	     GOTO-STATEMENT RETURN-STATEMENT EXIT-STATEMENT BLOCK 
	     LOOP-PARAMETER ITERATION-CLAUSE BASIC-LOOP LOOP-STATEMENT 
	     CASE-STATEMENT CONDITION IF-STATEMENT ASSIGNMENT-STATEMENT 
	     NULL-STATEMENT LABEL COMPOUND-STATEMENT SIMPLE-STATEMENT 
	     STATEMENT SEQUENCE-OF-STATEMENTS ALLOCATOR 
	     QUALIFIED-EXPRESSION TYPE-CONVERSION 
	     EXPONENTIATING-OPERATOR MULTIPLYING-OPERATOR UNARY-OPERATOR 
	     ADDING-OPERATOR RELATIONAL-OPERATOR LOGICAL-OPERATOR 
	     PRIMARY FACTOR TERM SIMPLE-EXPRESSION RELATION EXPRESSION 
	     COMPONENT-ASSOCIATION AGGREGATE LITERAL ATTRIBUTE 
	     SELECTED-COMPONENT SLICE INDEXED-COMPONENT NAME BODY 
	     PROGRAM-COMPONENT DECLARATIVE-ITEM DECLARATIVE-PART 
	     INCOMPLETE-TYPE-DECLARATION ACCESS-TYPE-DEFINITION CHOICE 
	     VARIANT-PART DISCRIMINANT-SPECIFICATION 
	     DISCRIMINANT-CONSTRAINT DISCRIMINANT-DECLARATION 
