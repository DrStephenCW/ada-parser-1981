EXPR GETPROD ();                % INPUT PRODUCTION AS LIST      %
   IN-STREAM _ LINEREAD ();

EXPR GETFILE ();
   BEGIN NEW FRED;
   \(INPUT FRED PROD);          % ALWAYS READS FROM FILE "PROD" %
   INC ('FRED);
   END;

EXPR CLOSEFILE();
  INC(NIL);

EXPR SCANTOKEN();               % RETURN NEXT TOKEN IN CURTOKEN %
  BEGIN 
    CURTOKEN _ CAR IN-STREAM;
    NEXTTOKEN _ CADR IN-STREAM;
    IN-STREAM _ CDR IN-STREAM;
  END;

EXPR TRANS();                   % TRANSLATE PRODUCTION TO MLISP %
  BEGIN NEW CURTOKEN, NEXTTOKEN, IN-STREAM;
  GETFILE();
  WHILE T DO:
  BEGIN
    GETPROD();
    SCANTOKEN();
    TTYMSG(T,CURTOKEN,T);
    IF CURTOKEN = 'END-OF-FILE THEN RETURN NIL;
                                % EXIT FROM THIS LOOP           %
    MSG(T,"EXPR ",CURTOKEN,"();",T);
    SCANTOKEN(); SCANTOKEN();         % TOSS PROD NAME AND ::=      %
    WHILE CURTOKEN NEQ NIL DO: TOP();
    MSG(T,T);
  END;
  CLOSEFILE();
  RETURN ASCII(0);              % AVOID PRINTING FINAL NIL      %
  END;


EXPR XSPECIAL();
  BEGIN
  WHILE CURTOKEN = '?^ AND IN-STREAM[2] = '!
    DO: BEGIN SCANTOKEN(); MSG("CURRTOKEN = '",CURTOKEN," OR ",T);
              SCANTOKEN(); SCANTOKEN();
        END;
  IP(CURTOKEN); MSG(";",T);  SCANTOKEN();
  END;

EXPR TOP();
  BEGIN
      IF CURTOKEN = NIL THEN MSG(T) 
      ELSE IF CURTOKEN = '?^ AND IN-STREAM[2] = '! THEN XSPECIAL()             
      ELSE IF CURTOKEN EQSTR "[" THEN ONEOPTION()
      ELSE IF CURTOKEN EQSTR "{" THEN ZEROORMORE()
      ELSE IF CURTOKEN EQSTR "}" THEN NIL %FINISH-WHILE()%
      ELSE IF CURTOKEN EQSTR "]" THEN NIL %FINISH-IF()  %
      ELSE IF CURTOKEN = '! THEN ELSECLAUSE()
      ELSE PRODCALL(); 
  RETURN ASCII(0);
  END;

EXPR IP(X);
BEGIN
  IF X = '?^ THEN SCANTOKEN() ALSO MSG("CURRTOKEN = '",CURTOKEN," ")
  ELSE IF STRINGP(X) THEN MSG("CURRTOKEN = ",X," ")
  ELSE MSG(X,"() ");
  RETURN ASCII(00);
END;

EXPR PRODCALL();
  BEGIN
    IF NEXTTOKEN = '! OR (CURTOKEN = '?^ AND IN-STREAM[2] = '!)          
        THEN 
            BEGIN
              MSG(IP(CURTOKEN));
%             SCANTOKEN();    %
              SCANTOKEN();
              TOP();
            END 
    ELSE IF NEXTTOKEN = NIL 
            THEN 
              BEGIN
                MSG(IP(CURTOKEN),";",T);
                SCANTOKEN();
              END
    ELSE 
      BEGIN
        MSG("IF ",IP(CURTOKEN)," THEN BEGIN SCANTOKEN();",T);
        SCANTOKEN();
        WHILE CURTOKEN NEQ NIL 
          AND ~EQSTR(CURTOKEN,"]")
          AND ~EQSTR(CURTOKEN,"}")
                        DO: BEGIN TOP(); END;
        MSG("END ELSE ENDOF(PRODCALL);");
      END;
  END;

EXPR ELSECLAUSE(I);
  BEGIN
  MSG(" OR ");
  SCANTOKEN();
  TOP();
  END;

EXPR LITTOKEN(X);
  BEGIN
  SCANTOKEN();
  MSG("IF CURRTOKEN() = '",CURTOKEN," THEN BEGIN SCANTOKEN();",T);
  SCANTOKEN();
  TOP();
  MSG("END ELSE ENDOF(LITTOKEN);",T);
  END;

EXPR ONEOPTION(X);
  BEGIN
    SCANTOKEN();
    MSG("IF ", IP(CURTOKEN)," THEN BEGIN SCANTOKEN();",T);
    SCANTOKEN();
    WHILE ~(CURTOKEN EQSTR "]") DO: TOP();
    SCANTOKEN();
    MSG("END ELSE ENDOF(ONEOPTION);",T);
  END;

EXPR ZEROORMORE(X);
  BEGIN
    SCANTOKEN();
    MSG("WHILE ",IP(CURTOKEN)," DO: BEGIN SCANTOKEN();",T);
    SCANTOKEN();
    WHILE ~(CURTOKEN EQSTR "}") DO: TOP();
    SCANTOKEN();
    MSG(T,"ENDOF(ZEROOREMORE); END;");
  END;
  
EXPR FINISH-WHILE();
  BEGIN
  MSG(T,"MSG('SUCCESS-CURLY-BRACKET);",T);
  SCANTOKEN();
  TOP();
  END;

EXPR FINISH-IF();
  BEGIN
  MSG(T,"MSG('SUCCESS-BRACKET);",T);
  SCANTOKEN();
  TOP();
  END;

