EXPR GETFILE ();
   BEGIN NEW FRED;
   \(INPUT FRED PROD);          % ALWAYS READS FROM FILE "PROD" %
   INC ('FRED);
   END;

EXPR CLOSEFILE();
  INC(NIL);

EXPR PREAD();
  BEGIN NEW L,B;
    WHILE L _ LINEREAD(T) DO: B _ B @ L;
    RETURN B;
  END;

EXPR READFILE();
  BEGIN NEW X,Y;
1;  X _ PREAD();
    PUT(CAR X, CDDR X, 'GRAMMER);
    Y _ CAR X CONS Y;
    IF CAR X EQ 'END THEN RETURN CDR Y;
    GO 1;
  END;

RULES _ NIL;

PUSH(PRETTYPROPS, 'GRAMMER);

EXPR DOIT();
  BEGIN
    GETFILE();
    RULES _ READFILE();
    CLOSEFILE();
  END;
