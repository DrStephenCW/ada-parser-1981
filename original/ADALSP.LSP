(DE TEST NIL
(PROG (N GUESS1 GUESS2 DIF)
      (SETQ GUESS1 (// N 2.))
      (SETQ GUESS2 N)
 LOOPBEGIN1 
      (COND [(NOT (< GUESS1 GUESS2)) (GO NEXT1)])
      (SETQ DIF (- GUESS2 GUESS1))
      (GO ENDIF1)
 NEXT1 
      (SETQ DIF (- GUESS1 GUESS2))
 ENDIF1 
      (COND [(< DIF 2.) (GO LOOPEXIT1)])
      (SETQ GUESS2 GUESS1)
      (SETQ GUESS1 (- GUESS1 (// (* GUESS1 GUESS1) (* 2. GUESS1))))
      (GO LOOPBEGIN1)
 LOOPEXIT1)
)
