        
(DEFPROP PRAGMA
 ((^ PRAGMA) IDENTIFIER (/[ /( ARGUMENT (/{ /, ARGUMENT }) /) /]) ;)
 GRAMMAR)

(DEFPROP ARGUMENT ((/[ IDENTIFIER => /]) EXPRESSION) GRAMMAR)

(DEFPROP DECLARATION
 (OBJECT-DECLARATION ! NUMBER-DECLARATION ! TYPE-DECLARATION !
		     SUBTYPE-DECLARATION ! SUBPROGRAM-DECLARATION !
		     PACKAGE-DECLARATION ! TASK-DECLARACTION !
		     EXCEPTION-DECLARATION ! RENAMING-DECLARATION ! PRAGMA)
 GRAMMAR)

(DEFPROP TYPE-PART (SUBTYPE-INDICATION ! ARRAY-TYPE-INDICATION) GRAMMAR)

(DEFPROP OBJECT-DECLARATION
 (IDENTIFIER-LIST : (/[ (^ CONSTANT) /]) TYPE-PART (/[ := EXPRESSION /]))
 GRAMMAR)

(DEFPROP NUMBER-DECLARATION
 (IDENTIFIER-LIST : (^ CONSTANT) := EXPRESSION ;)
 GRAMMAR)

(DEFPROP IDENTIFIER-LIST (IDENTIFIER (/{ /, IDENTIFIER })) GRAMMAR)

(DEFPROP TYPE-DEFINITION
 (ENUMERATION-TYPE-DEFINITION ! INTEGER-TYPE-DEFINITION !
			      REAL-TYPE-DEFINITION ! ARRAY-TYPE-DEFINITION
			      ! RECORD-TYPE-DEFINITION !
			      ACCESS-TYPE-DEFINITION !
			      DERIVED-TYPE-DEFINITION !
			      PRIVATE-TYPE-DEFINITION)
 GRAMMAR)

(DEFPROP TYPE-DECLARATION
 (((^ TYPE) IDENTIFIER (/[ DISCRIMINANT-PART /]) (^ IS) TYPE-DEFINITION ;)
  ! 
  INCOMPLETE-TYPE-DECLARATION)
 GRAMMAR)

(DEFPROP SUBTYPE-DECLARATION
 ((^ SUBTYPE) IDENTIFIER (^ IS) SUBTYPE-INDICATION ;)
 GRAMMAR)

(DEFPROP SUBTYPE-INDICATION
 ((NAME RANGE-CONSTRAINT) ! (NAME ACCURACY-CONSTRAINT) ! NAME)
 GRAMMAR)

(DEFPROP CONSTRAINT
 (RANGE-CONSTRAINT ! ACCURACY-CONSTRAINT ! UNIVERSAL-EXPRESSION-PACK)
 GRAMMAR)

(DEFPROP DERIVED-TYPE-DEFINITION ((^ NEW) SUBTYPE-INDICATION) GRAMMAR)

(DEFPROP RANGE-CONSTRAINT ((^ RANGE) RANGE) GRAMMAR)

(DEFPROP RANGE (SIMPLE-EXPRESSION /./. SIMPLE-EXPRESSION) GRAMMAR)

(DEFPROP ENUMERATION-TYPE-DEFINITION
 (/( ENUMERATION-LITERAL (/{ /, ENUMERATION-LITERAL }) /))
 GRAMMAR)

(DEFPROP ENUMERATION-LITERAL (IDENTIFIER ! CHARACTER-LITERAL) GRAMMAR)

(DEFPROP INTEGER-TYPE-DEFINITION (RANGE-CONSTRAINT) GRAMMAR)

(DEFPROP REAL-TYPE-DEFINITION (ACCURACY-CONSTRAINT) GRAMMAR)

(DEFPROP ACCURACY-CONSTRAINT
 (FLOATING-POINT-CONSTRAINT ! FIXED-POINT-CONSTRAINT)
 GRAMMAR)

(DEFPROP FLOATING-POINT-CONSTRAINT
 ((^ DIGITS) SIMPLE-EXPRESSION (/[ RANGE-CONSTRAINT /]))
 GRAMMAR)

(DEFPROP FIXED-POINT-CONSTRAINT
 ((^ DELTA) SIMPLE-EXPRESSION (/[ RANGE-CONSTRAINT /]))
 GRAMMAR)

(DEFPROP ARRAY-TYPE-DEFINITION
 (((^ ARRAY) /( INDEX (/{ /, INDEX }) /) (^ OF) SUBTYPE-INDICATION)
  ! 
  ((^ ARRAY) CONSTRAINT (^ OF) SUBTYPE-INDICATION))
 GRAMMAR)

(DEFPROP INDEX (NAME (^ RANGE) <>) GRAMMAR)

(DEFPROP DISCRETE-RANGE
 ((NAME (/[ RANGE-CONSTRAINT /])) ! RANGE)
 GRAMMAR)

(DEFPROP RECORD-TYPE-DEFINITION
 ((^ RECORD) COMPONENT-LIST (^ END) (^ RECORD))
 GRAMMAR)

(DEFPROP COMPONENT-LIST
 (((/{ COMPONENT-DECLARATION }) (/[ VARIANT-PART /]))
  ! 
  ((^ NULL) ;))
 GRAMMAR)

(DEFPROP COMPONENT-DECLARATION
 (IDENTIFIER-LIST : TYPE-PART (/[ := EXPRESSION /]) ;)
 GRAMMAR)

(DEFPROP DISCRIMINANT-PART
 (/( DISCRIMINANT-DECLARATION (/{ /, DISCRIMINANT-DECLARATION }) /))
 GRAMMAR)

(DEFPROP DISCRIMINANT-DECLARATION
 (IDENTIFIER-LIST : SUBTYPE-INDICATION (/[ := EXPRESSION /]))
 GRAMMAR)

(DEFPROP VARIANT-PART
 ((^ CASE)
  NAME 
  (^ IS)
  (/{ (^ WHEN) CHOICE (/{ | CHOICE }) => COMPONENT-LIST })
  (^ END)
  (^ CASE)
  ;)
 GRAMMAR)

(DEFPROP CHOICE
 (SIMPLE-EXPRESSION ! NAME RANGE-CONSTRAINT ! RANGE ! (^ OTHERS))
 GRAMMAR)

(DEFPROP ACCESS-TYPE-DEFINITION ((^ ACCESS) SUBTYPE-INDICATION) GRAMMAR)

(DEFPROP INCOMPLETE-TYPE-DECLARATION
 ((^ TYPE) IDENTIFIER (/[ DISCRIMINANT-PART /]) ;)
 GRAMMAR)

(DEFPROP BODY (SUBPROGRAM-BODY ! PACKAGE-BODY ! TASK-BODY) GRAMMAR)

(DEFPROP PROGRAM-COMPONENT (BODY ! BODY-STUB) GRAMMAR)

(DEFPROP DECLARATION-ITEM (DECLARATION ! USE-CLAUSE) GRAMMAR)

(DEFPROP UNIVERSAL-DECLARATION
 (DECLARATION-ITEM ! REPRESENTATION-SPECIFICATION ! PROGRAM-COMPONENT)
 GRAMMAR)

(DEFPROP DECLARATIVE-PART (/{ UNIVERSAL-DECLARATION ; }) GRAMMAR)

(DEFPROP DECLARATIVE-ITEM (DECLARATION ! USE-CLAUSE) GRAMMAR)

(DEFPROP PROGRAM-COMPONENT (BODY ! BODY-STUB) GRAMMAR)

(DEFPROP BODY (SUBPROGRAM-BODY ! PACKAGE-BODY ! TASK-BODY) GRAMMAR)

(DEFPROP NAME (IDENTIFIER (/{ NAME-TAIL })) GRAMMAR)

(DEFPROP NAME-TAIL
  (  (/. SELECTED-COMPONENT-TAIL)
   ! (/./. NAME)
   ! ( /( UNIVERSAL-EXPRESSION-PACK /) )
   ! ( /' ATTRIBUTE-NAME))
 GRAMMAR)

(DEFPROP SELECTED-COMPONENT-TAIL
 ((^ ALL) ! IDENTIFIER ! OPERATOR-SYMBOL)
 GRAMMAR)

(DEFPROP ATTRIBUTE (NAME) GRAMMAR)

(DEFPROP ATTRIBUTE-NAME
 ((^ DELTA) ! (^ DIGITS) ! (^ RANGE) ! IDENTIFIR)
 GRAMMAR)

(DEFPROP LITERAL
 (NUMERIC-LITERAL ! CHARACTER-LITERAL ! (^ NULL))
 GRAMMAR)

(DEFPROP CHOICE
 (SIMPLE-EXPRESSION ! NAME RANGE-CONSTRAINT ! RANGE ! (^ OTHERS))
 GRAMMAR)

(DEFPROP CHOICE-LIST (CHOICE /{ | CHOICE }) GRAMMAR)

(DEFPROP EXPRESSION-TAIL
 (((^ AND) (^ THEN) RELATION)
  ! 
  ((^ OR) (^ ELSE) RELATION)
  ! 
  ((^ XOR) RELATION)
  ! 
  ((^ OR) RELATION)
  ! 
  ((^ AND) RELATION))
 GRAMMAR)

(DEFPROP EXPRESSION (RELATION (/[ EXPRESSION-TAIL /])) GRAMMAR)

(DEFPROP UNIVERSAL-EXPRESSION
 (EXPRESSION ! 
	     (CHOICE-LIST => EXPRESSION)
	     ! 
	     (OTHERS => EXPRESSION)
	     ! 
	     (NAME RANGE-CONSTRAINT)
	     ! 
	     RANGE)
 GRAMMAR)

(DEFPROP UNIVERSAL-EXPRESSION-PACK (/{ UNIVERSAL-EXPRESSION }) GRAMMAR)

(DEFPROP RELATION
 ((SIMPLE-EXPRESSION (/[ RELATIONAL-OPERATOR SIMPLE-EXPRESSION /]))
  ! 
  (SIMPLE-EXPRESSION (/[ (^ NOT) /]) (^ IN) RANGE)
  ! 
  (SIMPLE-EXPRESSION (/[ (^ NOT) /]) (^ IN) SUBTYPE-INDICATION))
 GRAMMAR)

(DEFPROP SIMPLE-EXPRESSION
 ((/[ UNARY-OPERATOR /]) TERM (/{ ADDING-OPERATOR TERM }))
 GRAMMAR)

(DEFPROP TERM (FACTOR (/{ MULTIPLYING-OPERATOR FACTOR })) GRAMMAR)

(DEFPROP FACTOR (PRIMARY (/[ ** PRIMARY /])) GRAMMAR)

(DEFPROP PRIMARY
 (LITERAL ! NAME ! ALLOCATOR ! QUALIFIED-EXPRESSION !
          ( /( UNIVERSAL-EXPRESSION-PACK /) ))
 GRAMMAR)

(DEFPROP LOGICAL-OPERATOR ((^ AND) ! (^ OR) ! (^ XOR)) GRAMMAR)

(DEFPROP RELATIONAL-OPERATOR (= ! //= ! < ! <= ! > ! >=) GRAMMAR)

(DEFPROP ADDING-OPERATOR (+ ! /- ! &) GRAMMAR)

(DEFPROP UNARY-OPERATOR (+ ! /- ! (^ NOT)) GRAMMAR)

(DEFPROP MULTIPLYING-OPERATOR (* ! // ! (^ MOD) ! (^ REM)) GRAMMAR)

(DEFPROP EXPONENTIATING-OPERATOR (**) GRAMMAR)

(DEFPROP QUALIFIED-EXPRESSION
 (IDENTIFIER /' UNVERSIAL-EXPRESSION-PACK)
 GRAMMAR)

(DEFPROP ALLOCATOR ((^ NEW) NAME) GRAMMAR)

(DEFPROP SEQUENCE-OF-STATEMENTS (STATEMENT (/{ STATEMENT })) GRAMMAR)

(DEFPROP STATEMENT
 (((/{ LABEL }) SIMPLE-STATEMENT)
  ! 
  ((/{ LABEL }) COMPOUND-STATEMENT)
  ! 
  PRAGMA)
 GRAMMAR)

(DEFPROP SIMPLE-STATEMENT
 (NULL-STATEMENT ! ASSIGNMENT-STATEMENT ! EXIT-STATEMENT ! RETURN-STATEMENT
		 ! GOTO-STATEMENT ! PROCEDURE-CALL ! DELAY-STATEMENT !
		 ABORT-STATEMENT ! RAISE-STATEMENT ! CODE-STATEMENT)
 GRAMMAR)

(DEFPROP COMPOUND-STATEMENT
 (IF-STATEMENT ! CASE-STATEMENT ! LOOP-STATEMENT ! BLOCK ! ACCEPT-STATEMENT
	       ! SELECT-STATEMENT)
 GRAMMAR)

(DEFPROP LABEL (<< IDENTIFIER >>) GRAMMAR)

(DEFPROP NULL-STATEMENT ((^ NULL) ;) GRAMMAR)

(DEFPROP ASSIGNMENT-STATEMENT (NAME := EXPRESSION ;) GRAMMAR)

(DEFPROP IF-STATEMENT
 ((^ IF)
  CONDITION 
  (^ THEN)
  SEQUENCE-OF-STATEMENTS 
  (/{ (^ ELSIF) CONDITION (^ THEN) SEQUENCE-OF-STATEMENTS })
  (/[ (^ ELSE) SEQUENCE-OF-STATEMENTS /])
  (^ END)
  (^ IF)
  ;)
 GRAMMAR)

(DEFPROP CONDITION (EXPRESSION) GRAMMAR)

(DEFPROP CASE-STATEMENT
 ((^ CASE)
  EXPRESSION 
  (^ IS)
  (/{ (^ WHEN) CHOICE (/{ | CHOICE }) => SEQUENCE-OF-STATEMENTS })
  (^ END)
  (^ CASE)
  ;)
 GRAMMAR)

(DEFPROP LOOP-STATEMENT
 ((/[ IDENTIFIER /: /])
  (/[ ITERATION-CLAUSE /])
  BASIC-LOOP 
  (/[ IDENTIFIER /])
  ;)
 GRAMMAR)

(DEFPROP BASIC-LOOP
 ((^ LOOP) SEQUENCE-OF-STATEMENTS (^ END) (^ LOOP))
 GRAMMAR)

(DEFPROP ITERATION-CLAUSE
 (((^ FOR) IDENTIFIER (^ IN) (/[ (^ REVERSE) /]) DISCRETE-RANGE)
  ! 
  ((^ WHILE) CONDITION))
 GRAMMAR)

(DEFPROP BLOCK
 ((/[ IDENTIFIER /: /])
  (/[ (^ DECLARE) DECLARATIVE-PART /])
  (^ BEGIN)
  SEQUENCE-OF-STATEMENTS 
  (/[ (^ EXCEPTION) (/{ EXCEPTION-HANDLER }) /])
  (^ END)
  (/[ IDENTIFIER /])
  ;)
 GRAMMAR)

(DEFPROP EXIT-STATEMENT
 ((^ EXIT) (/[ NAME /]) (/[ (^ WHEN) CONDITION /]) ;)
 GRAMMAR)

(DEFPROP RETURN-STATEMENT ((^ RETURN) (/[ EXPRESSION /]) ;) GRAMMAR)

(DEFPROP GOTO-STATEMENT ((^ GOTO) NAME ;) GRAMMAR)

(DEFPROP SUBPROGRAM-DECLARATION
 ((SUBPROGRAM-SPECIFICATION ;)
  ! 
  GENERIC-SUBPROGRAM-DECLARATION 
  ! 
  GENERIC-SUBPROGRAM-INSTANTIATION)
 GRAMMAR)

(DEFPROP SUBPROGRAM-SPECIFICATION
 (((^ PROCEDURE) IDENTIFIER (/[ FORMAL-PART /]))
  ! 
  ((^ FUNCTION)
   DESIGNATOR 
   (/[ FORMAL-PART /])
   (^ RETURN)
   SUBTYPE-INDICATION))
 GRAMMAR)

(DEFPROP DESIGNATOR (IDENTIFIER ! OPERATOR-SYMBOL) GRAMMAR)

(DEFPROP OPERATOR-SYMBOL (CHARACTER-STRING) GRAMMAR)

(DEFPROP FORMAL-PART
 (/( PARAMETER-DECLARATION (/{ ; PARAMETER-DECLARATION }) /))
 GRAMMAR)

(DEFPROP PARAMETER-DECLARATION
 (IDENTIFIER-LIST : MODE SUBTYPE-INDICATION (/[ := EXPRESSION /]))
 GRAMMAR)

(DEFPROP MODE ((^ OUT) ! ((^ IN) (^ OUT)) ! (/[ (^ IN) /])) GRAMMAR)

(DEFPROP SUBPROGRAM-BODY
 (SUBPROGRAM-SPECIFICATION
  (^ IS)
  DECLARATIVE-PART 
  (^ BEGIN)
  SEQUENCE-OF-STATEMENTS 
  (/[ (^ EXCEPTION) (/{ EXCEPTION-HANDLER }) /])
  (^ END)
  (/[ DESIGNATOR /])
  ;)
 GRAMMAR)

(DEFPROP PROCEDURE-CALL (NAME) GRAMMAR)

(DEFPROP FUNCTION-CALL (NAME /( /)) GRAMMAR)

(DEFPROP PACKAGE-DECLARATION
 ((PACKAGE-SPECIFICATION ;)
  ! 
  GENERIC-PACKAGE-DECLARATION 
  ! 
  GENERIC-PACKAGE-INSTANTIATION)
 GRAMMAR)

(DEFPROP PACKAGE-SPECIFICATION
 ((^ PACKAGE)
  IDENTIFIER 
  (^ IS)
  (/{ DECLARATIVE-ITEM })
  (/[ (^ PRIVATE)
      (/{ DECLARATIVE-ITEM })
      (/{ REPRESENTATION-SPECIFICATION })
      /])
  (^ END)
  (/[ IDENTIFIER /]))
 GRAMMAR)

(DEFPROP PACKAGE-BODY
 ((^ PACKAGE)
  (^ BODY)
  IDENTIFIER 
  (^ IS)
  DECLARATIVE-PART 
  (/[ (^ BEGIN)
      SEQUENCE-OF-STATEMENTS 
      (/[ (^ EXCEPTION) (/{ EXCEPTION-HANDLER }) /])
      /])
  (^ END)
  (/[ IDENTIFIER /])
  ;)
 GRAMMAR)

(DEFPROP PRIVATE-TYPE-DEFINITION
 ((/[ (^ LIMITED) /]) (^ PRIVATE))
 GRAMMAR)

(DEFPROP USE-CLAUSE ((^ USE) NAME (/{ /, NAME }) ;) GRAMMAR)

(DEFPROP RENAMING-DECLARATION
 ((IDENTIFIER : (^ EXCEPTION) (^ RENAMES) NAME)
  ! 
  ((^ PACKAGE) IDENTIFIER (^ RENAMES) NAME)
  ! 
  ((^ TASK) IDENTIFIER (^ RENAMES) NAME)
  ! 
  (SUBPROGRAM-SPECIFICATION (^ RENAMES) NAME)
  ! 
  (IDENTIFIER (^ RENAMES) NAME))
 GRAMMAR)

(DEFPROP TASK-DECLARATION (TASK-SPECIFICATION) GRAMMAR)

(DEFPROP TASK-SPECIFICATION
 ((^ TASK)
  (/[ (^ TYPE) /])
  IDENTIFIER 
  (/[ (^ IS)
      (/{ ENTRY-DECLARATION })
      (/{ REPRESENTATION-SPECIFICATION })
      (^ END)
      (/[ IDENTIFIER /])
      /])
  ;)
 GRAMMAR)

(DEFPROP TASK-BODY
 ((^ TASK)
  (^ BODY)
  IDENTIFIER 
  (^ IS)
  (/[ DECLARATIVE-PART /])
  (^ BEGIN)
  SEQUENCE-OF-STATEMENTS 
  (/[ (^ EXCEPTION) (/{ EXCEPTION-HANDLER }) /])
  (^ END)
  (/[ IDENTIFIER /])
  ;)
 GRAMMAR)

(DEFPROP ENTRY-DECLARATION
 ((^ ENTRY) IDENTIFIER (/[ /( DISCRETE-RANGE /) /]) (/[ FORMAL-PART /]) ;)
 GRAMMAR)

(DEFPROP ENTRY-CALL (NAME (/[ /( ACTUAL-PARAMETER-PART /) /]) ;) GRAMMAR)

(DEFPROP ACCEPT-STATEMENT
 ((^ ACCEPT)
  ACCEPT-NAME 
  (/[ FORMAL-PART /])
  (/[ (^ DO) SEQUENCE-OF-STATEMENTS (^ END) (/[ IDENTIFIER /]) /])
  ;)
 GRAMMAR)

(DEFPROP ACCEPT-NAME (IDENTIFIER (/[ EXPRESSION /])) GRAMMAR)

(DEFPROP DELAY-STATEMENT ((^ DELAY) SIMPLE-EXPRESSION ;) GRAMMAR)

(DEFPROP SELECT-STATEMENT
 (SELECTIVE-WAIT ! CONDITIONAL-ENTRY-CALL ! TIMED-ENTRY-CALL)
 GRAMMAR)

(DEFPROP SELECTIVE-WAIT
 ((^ SELECT)
  (/[ (^ WHEN) CONDITION => /])
  SELECT-ALTERNATIVE 
  (/{ (^ OR) (/[ (^ WHEN) CONDITION => /]) SELECT-ALTERNATIVE })
  (/[ (^ ELSE) SEQUENCE-OF-STATEMENTS /])
  (^ END)
  (^ SELECT)
  ;)
 GRAMMAR)

(DEFPROP SELECT-ALTERNATIVE
 ((ACCEPT-STATEMENT (/[ SEQUENCE-OF-STATEMENTS /]))
  ! 
  (DELAY-STATEMENT (/[ SEQUENCE-OF-STATEMENTS /]))
  ! 
  ((^ TERMINATE) ;))
 GRAMMAR)

(DEFPROP CONDITIONAL-ENTRY-CALL
 ((^ SELECT)
  ENTRY-CALL 
  (/[ SEQUENCE-OF-STATEMENTS /])
  (^ ELSE)
  SEQUENCE-OF-STATEMENTS 
  (^ END)
  (^ SELECT)
  ;)
 GRAMMAR)

(DEFPROP TIMED-ENTRY-CALL
 ((^ SELECT)
  ENTRY-CALL 
  (/[ SEQUENCE-OF-STATEMENTS /])
  (^ OR)
  DELAY-STATEMENT 
  (/[ SEQUENCE-OF-STATEMENTS /])
  (^ END)
  (^ SELECT)
  ;)
 GRAMMAR)

(DEFPROP ABORT-STATEMENT ((^ ABORT) NAME (/{ /, ^ TASK-NAME })) GRAMMAR)

(DEFPROP COMPILATION ((/{ COMPILATION-UNIT })) GRAMMAR)

(DEFPROP COMPILATION-UNIT
 ((CONTEXT-SPECIFICATION SUBPROGRAM-DECLARATION)
  ! 
  (CONTEXT-SPECIFICATION SUBPROGRAM-BODY)
  ! 
  (CONTEXT-SPECIFICATION PACKAGE-DECLARATION)
  ! 
  (CONTEXT-SPECIFICATION PACKAGE-BODY)
  ! 
  (CONTEXT-SPECIFICATION SUBUNIT)
  ! 
  (PRAGMA))
 GRAMMAR)

(DEFPROP CONTEXT-SPECIFICATION
 ((/{ WITH-CLAUSE (/[ USE-CLAUSE /]) }))
 GRAMMAR)

(DEFPROP WITH-CLAUSE ((^ WITH) NAME (/{ /, NAME }) ;) GRAMMAR)

(DEFPROP SUBUNIT ((^ SEPARATE) /( NAME /) SUBUNIT-BODY) GRAMMAR)

(DEFPROP SUBUNIT-BODY
 (SUBPROGRAM-BODY ! PACKAGE-BODY ! TASK-BODY)
 GRAMMAR)

(DEFPROP BODY-STUB
 ((SUBPROGRAM-SPECIFICATION (^ IS) (^ SEPARATE) ;)
  ! 
  (PACKAGE-BODY IDENTIFIER (^ IS) (^ SEPARATE) ;)
  ! 
  ((^ TASK) (^ BODY) IDENTIFIER (^ IS) (^ SEPARATE) ;))
 GRAMMAR)

(DEFPROP EXCEPTION-DECLARATION
 (IDENTIFIER-LIST : (^ EXCEPTION) ;)
 GRAMMAR)

(DEFPROP EXCEPTION-HANDLER
 ((^ WHEN)
  EXCEPTION-CHOICE 
  (/{ | EXCEPTION-CHOICE })
  => 
  SEQUENCE-OF-STATEMENTS)
 GRAMMAR)

(DEFPROP EXCEPTION-CHOICE (NAME ! (^ OTHERS)) GRAMMAR)

(DEFPROP RAISE-STATEMENT ((^ RAISE) (/[ NAME /]) ;) GRAMMAR)

(DEFPROP GENERIC-SUBPROGRAM-DECLARATION
 (GENERIC-PART SUBPROGRAM-SPECIFICATION ;)
 GRAMMAR)

(DEFPROP GENERIC-PACKAGE-DECLARATION
 (GENERIC-PART PACKAGE-SPECIFICATION ;)
 GRAMMAR)

(DEFPROP GENERIC-PART
 ((^ GENERIC) (/{ GENERIC-FORMAL-PARAMETER }))
 GRAMMAR)

(DEFPROP GENERIC-FORMAL-PARAMETER
 ((PARAMETER-DECLARATION ;)
  ! 
  ((^ TYPE)
   IDENTIFIER 
   (/[ DISCRIMINANT-PART /])
   (^ IS)
   GENERIC-TYPE-DEFINITION 
   ;)
  ! 
  ((^ WITH) SUBPROGRAM-SPECIFICATION (/[ (^ IS) NAME /]) ;)
  ! 
  ((^ WITH) SUBPROGRAM-SPECIFICATION (^ IS) <> ;))
 GRAMMAR)

(DEFPROP GENERIC-TYPE-DEFINITION
 ((/( <> /))
  ! 
  ((^ RANGE) <>)
  ! 
  ((^ DELTA) <>)
  ! 
  ((^ DIGITS) <>)
  ! 
  ARRAY-TYPE-DEFINITION 
  ! 
  ACCESS-TYPE-DEFINITION 
  ! 
  PRIVATE-TYPE-DEFINITION)
 GRAMMAR)

(DEFPROP GENERIC-SUBPROGRAM-INSTANTIATION
 (((^ PROCEDURE) IDENTIFIER (^ IS) GENERIC-INSTANTIATION ;)
  ! 
  ((^ FUNCTION) DESIGNATOR (^ IS) GENERIC-INSTANTIATION ;))
 GRAMMAR)

(DEFPROP GENERIC-PACKAGE-INSTANTIATION
 ((^ PACKAGE) IDENTIFIER (^ IS) GENERIC-INSTANTIATION ;)
 GRAMMAR)

(DEFPROP GENERIC-INSTANTIATION ((^ NEW) NAME) GRAMMAR)

(DEFPROP REPRESENTATION-SPECIFICATION
 (LENGTH-SPECIFICATION-OR-ENUMERATION-TYPE-REPRESENTATION
  ! 
  RECORD-TYPE-REPRESENTATION 
  ! 
  ADDRESS-SPECIFICATION)
 GRAMMAR)

(DEFPROP LENGTH-SPECIFICATION-OR-ENUMERATION-TYPE-REPRESENTATION
 ((^ FOR) ATTRIBUTE (^ USE) EXPRESSION ;)
 GRAMMAR)

(DEFPROP RECORD-TYPE-REPRESENTATION
 ((^ FOR)
  NAME 
  (^ USE)
  (^ RECORD)
  (/[ ALIGNMENT-CLAUSE ; /])
  (/{ NAME LOCATION ; })
  (^ END)
  (^ RECORD)
  ;)
 GRAMMAR)

(DEFPROP LOCATION ((^ AT) SIMPLE-EXPRESSION (^ RANGE) RANGE) GRAMMAR)

(DEFPROP ALIGNMENT-CLAUSE ((^ AT) (^ MOD) SIMPLE-EXPRESSION) GRAMMAR)

(DEFPROP ADDRESS-SPECIFICATION
 ((^ FOR) NAME (^ USE) (^ AT) SIMPLE-EXPRESSION ;)
 GRAMMAR)

(DEFPROP CODE-STATEMENT (QUALIFIED-EXPRESSION ;) GRAMMAR)

(DEFPROP IDENTIFIER ((^ A) ! (^ B) ! (^ C)) GRAMMAR)

(DEFPROP NUMERIC-LITERAL (1 ! 2) GRAMMAR)

(DEFPROP CHARACTER-LITERAL (^ C-LIT) GRAMMAR)

